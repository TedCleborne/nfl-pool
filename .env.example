# Supabase — get these from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The Odds API — sign up at https://the-odds-api.com (free tier = 500 req/month)
ODDS_API_KEY=your-odds-api-key

# Admin panel password — choose anything, this protects /admin
ADMIN_PASSWORD=your-secret-admin-password

# Used by the seed script to create auth users
# Must match NEXT_PUBLIC_SUPABASE_URL above
SUPABASE_URL=https://your-project.supabase.co
